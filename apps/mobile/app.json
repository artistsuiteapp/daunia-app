{
  "expo": {
    "name": "Il Tifo della Daunia",
    "slug": "daunia",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "daunia",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#08080A",
    "splash": {
      "image": "./assets/brand/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#08080A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.daunia.app"
    },
    "android": {
      "package": "io.daunia.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "backgroundColor": "#08080A"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash.png",
          "imageWidth": 220,
          "backgroundColor": "#08080A",
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/brand/icon.png"
  }
}
