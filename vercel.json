{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": "apps/mobile/dist",
  "installCommand": "npm install",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, noimageindex"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/_expo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/match/:id",
      "destination": "/match/[id]"
    },
    {
      "source": "/player/:id",
      "destination": "/player/[id]"
    },
    {
      "source": "/post/:slug",
      "destination": "/post/[slug]"
    },
    {
      "source": "/curva/:id",
      "destination": "/curva/[id]"
    },
    {
      "source": "/trasferta/:id",
      "destination": "/trasferta/[id]"
    }
  ]
}
